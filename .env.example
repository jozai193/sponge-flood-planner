SPONGE_HOST=127.0.0.1
SPONGE_PORT=8787
SPONGE_STORAGE_ROOT=data/local
SPONGE_DATABASE_URL=postgresql+psycopg://sponge:sponge_local@127.0.0.1:55432/sponge
SPONGE_REDIS_URL=redis://127.0.0.1:56379/0
SPONGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPONGE_ENVIRONMENT=development
SPONGE_APP_VERSION=0.1.0
SPONGE_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
SPONGE_SESSION_LIMIT_PER_HOUR=120
SPONGE_SESSION_TTL_HOURS=168
SPONGE_RETENTION_INTERVAL_SECONDS=60
SPONGE_JOB_STALE_SECONDS=3600
SPONGE_CPU_REFERENCE_TIMEOUT_SECONDS=120
SPONGE_CPU_REFERENCE_CONCURRENCY=2
SPONGE_MAX_REQUEST_BODY_BYTES=25000000
SPONGE_MAX_TERRAIN_REQUEST_BYTES=102000000
# Comma-separated proxy IPs/CIDRs that may supply X-Forwarded-For. Leave blank for direct use.
SPONGE_TRUSTED_PROXY_CIDRS=
# Production container only: serve the compiled app from the API process.
# SPONGE_WEB_DIST=/app/dist
# Optional Dynamic World access; the service account/project must already have Earth Engine access.
SPONGE_EE_PROJECT=
# SPONGE_EE_CREDENTIALS_FILE=C:/private/earth-engine-service-account.json

# Optional NASA Earthdata user token; keep this server-side and never use a VITE_ prefix.
# SPONGE_EARTHDATA_TOKEN=
