  {
    "name": "metadata never proves accuracy",
    "scenario": {
      "version": 2,
      "engine": "webgl2-hll",
      "domain": {
        "nx": 4,
        "ny": 4,
        "dx_m": 2,
        "dy_m": 3,
        "horizontal_crs": "EPSG:32618",
        "vertical_datum": "NAVD88",
        "elevation_origin_m": 2,
        "bundle_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "forcing": {
        "version": 2,
        "components": {
          "rainfall": true,
          "external": true,
          "coastal": true
        },
        "storm": {
          "duration": 5,
          "recession": 615,
          "depth": 0.0025,
          "intervals": [
            {
              "start_s": 0,
              "end_s": 5,
              "rate_m_s": 0.0005
            }
          ]
        },
        "coastal": {
          "edge": "west",
          "cells": [
            0,
            4,
            8,
            12
          ],
          "levels": [
            {
              "timeS": 0,
              "elevationM": 0.2
            },
            {
              "timeS": 10,
              "elevationM": 0.4
            }
          ],
          "source": "controlled fixture",
          "datum": "local metres"
        },
        "inflows": [
          {
            "cell": 15,
            "flowM3S": 0.01,
            "startS": 0,
            "endS": 10,
            "source": "controlled fixture"
          }
        ],
        "outlets": []
      },
      "required_capabilities": [],
      "execution_input_hash": null
    },
    "manifest": {
      "bundle_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "grid": {
        "nx": 4,
        "ny": 4,
        "dx_m": 2,
        "dy_m": 3,
        "crs": "EPSG:32618",
        "vertical_datum": "NAVD88",
        "elevation_origin_m": 2
      },
      "quality": {
        "terrain_provider": "usgs_1m",
