{
  "$defs": {
    "SurveySource": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "attribution": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Attribution",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "horizontal_crs": {
          "title": "Horizontal Crs",
          "type": "string"
        },
        "vertical_datum": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Vertical Datum",
          "type": "string"
        },
        "license": {
          "maxLength": 300,
          "minLength": 2,
          "title": "License",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "surveyed",
            "provider_estimate",
            "user_assumption"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "title",
        "attribution",
        "observed_at",
        "horizontal_crs",
        "vertical_datum",
        "license",
        "provenance"
      ],
      "title": "SurveySource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "waterways",
        "catchments",
        "buildings",
        "landcover",
        "observations"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SurveySource"
    },
    "features": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 20000,
      "minItems": 1,
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "source",
    "features"
  ],
  "title": "VectorSurvey",
  "type": "object"
}
